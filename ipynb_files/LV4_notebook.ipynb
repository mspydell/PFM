    "fn_his = '/scratch/PFM_Simulations/LV4_Forecast/His/LV4_ocean_his_202501280000.nc'\n",
    "his = netCDF4.Dataset(fn_his)\n",
    "times = his.variables['ocean_time']\n",
    "times2 = netCDF4.num2date(times[:], times.units)\n",
    "times2 = np.array([datetime(year=date.year, month=date.month, day=date.day, \n",
    "                              hour=date.hour, minute=date.minute, second=date.second) for date in times2])\n",
    "\n",
    "nt = len(times2)\n",
    "ny = len(iys)\n",
    "dye1_hov = np.zeros((nt,ny))\n",
    "XX = np.zeros((ny))\n",
    "YY = np.zeros((ny))\n",
    "lt = np.zeros((ny))\n",
    "for aa in np.arange(ny):\n",
    "    dye1_hov[:,aa] = his.variables['dye_01'][:,-1,iys[aa],ixs[aa,0]]\n",
    "    XX[aa] = xx[iys[aa],ixs[aa]]\n",
    "    YY[aa] = yy[iys[aa],ixs[aa]]\n",
    "    lt[aa] = lats[iys[aa],ixs[aa]]\n",
    "\n",
    "dx = np.diff(XX)\n",
    "dy = np.diff(YY)\n",
    "l  = np.cumsum( np.sqrt( np.square(dx) + np.square(dy) ) )\n",
    "l = np.insert(l,0,0)\n",
    "\n",
    "print(np.shape(dye1_hov))\n"
   ]
