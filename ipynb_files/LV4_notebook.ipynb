    "def get_depth_indices(hb,iys,ix0,depth):\n",
    "    ny = len(iys)\n",
    "    ixs = np.zeros((ny,len(depth)),dtype=int)\n",
    "    cnt = 0\n",
    "    for dd in depth:\n",
    "        for aa in np.arange(ny):\n",
    "            hofx = hb[iys[aa],ix0:] - dd # we want to know when this crosses zero\n",
    "            zero_cross = np.where(np.diff(np.sign(hofx))) # this is the index of zero crossing\n",
    "            ixs[aa,cnt] = int( ix0+np.min(zero_cross) )\n",
    "        cnt=cnt+1\n",
    "\n",
    "    ixs.astype(int)\n",
    "    return ixs\n"
   ]
  },
