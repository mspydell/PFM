#!/bin/bash
# ---------------------------------------------------------------------------
# slurm_LV2_fwd.sb — submit one LV2 forward cycle (prior or analysis flavor).
# Env-vars (via `sbatch --export=...`):
#   ROMS_EXE  absolute path to romsM_forward
#   RIN       absolute path to staged LV2_{flavor}_YYYYMMDD.in
#   LOG       absolute path to write ROMS stdout
# ---------------------------------------------------------------------------

#SBATCH --job-name=LV2_fwd
#SBATCH --output=%j.out
#SBATCH --partition=fast
#SBATCH --cpus-per-task=1
#SBATCH --mem=128G
#SBATCH --ntasks-per-node=36
#SBATCH --nodes=6                    # 6x36 = 216 ranks; matches NtileI=9 x NtileJ=24
#SBATCH --time=0-04:00

module purge
module load slurm
module load intel-oneapi/oclfpga
module load intel-oneapi/compiler-rt
module load intel-oneapi/tbb
module load intel-oneapi/compiler
module load hdf5/ifort/mvapich2/1.14.3
module load netcdf-c/ifort/mvapich2
module load netcdf-fortran/ifort/mvapich2/4.6.1
module load mvapich2/ifort/2.3.7

# mvapich2 knobs (mirror slurm_4dvar.sb)
export MV2_HOMOGENEOUS_CLUSTER=1
export MV2_SMP_USE_CMA=0
export MV2_USE_MCAST=0
export MV2_NDREG_ENTRIES_MAX=131072
export MV2_NDREG_ENTRIES=65536

# Some fast-partition nodes don't have the system-wide /lib/libnetcdff.so.7
# that the login node ldd resolves to.  Explicitly export the module-provided
# path so srun propagates it into every rank's environment.
export LD_LIBRARY_PATH=/software/apps/netcdf-fortran/ifort/mvapich2/4.6.1/lib:/software/apps/netcdf-c/ifort/mvapich2/4.9.2/lib:/software/apps/hdf5/ifort/mvapich2/1.14.3/lib:$LD_LIBRARY_PATH

: "${ROMS_EXE:?export ROMS_EXE=/scratch/matt/DA_Simulations/LV2/Run/romsM_forward}"
: "${RIN:?export RIN=/scratch/matt/DA_Simulations/LV2/Run/LV2_{flavor}_YYYYMMDD.in}"
: "${LOG:?export LOG=/dataSIO/DA_Simulations/LV2/output_files/log_files/LV2_fwd_{flavor}_YYYYMMDD.log}"

# Write ROMS stdout to /scratch during the run (fast local NFS), then move
# to the final /dataSIO destination after srun exits.  Writing 144 ranks'
# worth of stdout line-by-line onto /dataSIO would starve the run.
SCRATCH_LOG="/scratch/matt/DA_Simulations/LV2/Run/$(basename "$LOG")"

srun --mpi=pmi2 --export=ALL --kill-on-bad-exit=1 -v \
     env LD_LIBRARY_PATH="$LD_LIBRARY_PATH" "$ROMS_EXE" "$RIN" > "$SCRATCH_LOG" 2>&1
rc=$?

mkdir -p "$(dirname "$LOG")"
mv "$SCRATCH_LOG" "$LOG"
exit $rc
